# Configuration du back, pour le développement sur le PC.
# Copier ce fichier en .env (ignoré par Git), puis remplir les valeurs :
#   cp .env.example .env
# Une variable déjà définie dans le terminal (ou par systemd sur le Pi) l'emporte sur ce fichier.

# Mode : marmotte.settings.dev (PC) ou marmotte.settings.prod (Pi, et valeur par défaut).
DJANGO_SETTINGS_MODULE=marmotte.settings.dev

# Clé secrète de Django, obligatoire. En générer une avec :
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Noms acceptés par le serveur, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Dossier des données du babyphone (facultatif, par défaut backend/.data).
# MARMOTTE_DATA_DIR=
